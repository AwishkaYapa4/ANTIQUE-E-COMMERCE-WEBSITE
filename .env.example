# Used by docker-compose.yml. Copy to .env and replace every value. Never commit .env.

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=antique_store
MYSQL_USER=antique_app
MYSQL_PASSWORD=change-me-app-password

# --- API container ---
# Firebase project id (Firebase console → Project settings)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account JSON as a single line (Project settings → Service accounts → Generate new private key).
# Keep this secret. Prefer your host's secret manager in production.
FIREBASE_CREDENTIALS_JSON=
# Image storage: Local (dev only) or Cloudinary
STORAGE_PROVIDER=Local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public URL of the site (canonical URLs + sitemap), e.g. https://www.example.lk
PUBLIC_BASE_URL=http://localhost:8080

# --- Frontend build (baked into the static bundle; these are NOT secrets) ---
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
