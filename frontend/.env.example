# Frontend configuration (Vite). Copy to .env.local. These values are public web config, not secrets.
# API base URL. Leave empty to use the same origin (dev proxy / single-host deployment).
VITE_API_BASE_URL=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development with the Firebase Auth Emulator (no real project needed), e.g. 127.0.0.1:9099
# When set, use VITE_FIREBASE_PROJECT_ID=demo-antique-store and any non-empty API key.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
